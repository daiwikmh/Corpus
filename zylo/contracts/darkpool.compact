pragma language_version 0.26;

import CompactStandardLibrary;

// ─────────────────────────────────────────────────────────────────────────────
// Zylo Dark Pool — sealed-order commitment core (Midnight / Compact)
//
// This is the Level 1 contract: the smallest piece of the dark pool that still
// carries its thesis — orders that can be placed, held and matched without their
// terms ever becoming public.
//
// PUBLIC (on the ledger, anyone can read):
//   orderCount        — how many sealed orders have ever been placed
//   orderCommitments  — one hiding hash per order; reveals nothing about it
//   settled           — nullifiers of orders already matched (stops double-fill)
//   lastPrint         — the single uniform price of the most recent settlement,
//                       and the ONLY price this contract ever discloses
//
// PRIVATE (circuit inputs + witness, never written in the clear):
//   side, limitPrice, size  — the terms of every order
//   orderSecret()           — the trader's per-order secret; without it a
//                             commitment cannot be reproduced, so it gates who
//                             can settle an order and links nothing on-chain
//
// PROVED WITHOUT REVEALING:
//   placeOrder — "I committed to a well-formed order (size > 0, price > 0)"
//                without exposing side, price or size.
//   settle     — "this fill corresponds to a real prior commitment, has not
//                 been settled before, and crosses the clearing price"
//                without exposing which order it was or its terms.
//
// Every disclose() below hands the ledger a hash or the agreed clearing price —
// never an order term. They are annotated at each use.
// ─────────────────────────────────────────────────────────────────────────────

export ledger orderCount: Counter;
export ledger orderCommitments: Set<Bytes<32>>;
export ledger settled: Set<Bytes<32>>;
export ledger lastPrint: Maybe<Uint<64>>;

// 0 = BUY, 1 = SELL. Kept as a small int so it casts cleanly into the hash.
witness orderSecret(): Bytes<32>;

constructor() {
  lastPrint = none<Uint<64>>();
}

// Commitment to an order's full terms. Binding (any change of terms changes the
// hash) and hiding (orderSecret is a 32-byte secret mixed in before hashing).
circuit orderCommitment(side: Uint<8>, limitPrice: Uint<64>, size: Uint<64>): Bytes<32> {
  const terms = persistentHash<Vector<3, Field>>(
    [side as Field, limitPrice as Field, size as Field]
  );
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "zylo:order:v1"), orderSecret(), terms]
  );
}

// Place a sealed order. side/limitPrice/size arrive as private circuit inputs;
// only the commitment hash is disclosed to the ledger.
export circuit placeOrder(side: Uint<8>, limitPrice: Uint<64>, size: Uint<64>): [] {
  assert(side <= 1, "side must be 0 (buy) or 1 (sell)");
  assert(size > 0, "size must be positive");
  assert(limitPrice > 0, "limit price must be positive");

  const commitment = orderCommitment(side, limitPrice, size);
  // disclose: a hiding hash of the order, not the order.
  orderCommitments.insert(disclose(commitment));
  orderCount.increment(1);
}

// Settle one order against a clearing price. The caller re-supplies the order's
// private terms; the circuit proves they match a live commitment and cross,
// without revealing them.
export circuit settle(
  side: Uint<8>,
  limitPrice: Uint<64>,
  size: Uint<64>,
  clearingPrice: Uint<64>
): [] {
  assert(clearingPrice > 0, "clearing price must be positive");

  const commitment = orderCommitment(side, limitPrice, size);
  assert(orderCommitments.member(disclose(commitment)), "no such sealed order");

  const nullifier = persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "zylo:null:v1"), commitment]
  );
  assert(!settled.member(disclose(nullifier)), "order already settled");

  const crosses =
    (side == 0)
      ? (limitPrice >= clearingPrice)
      : (limitPrice <= clearingPrice);
  assert(crosses, "order does not cross the clearing price");

  // disclose: the nullifier is a hash; spending it publicly is the point.
  settled.insert(disclose(nullifier));
  // disclose: the clearing price is the one figure a batch auction makes public.
  lastPrint = disclose(some<Uint<64>>(clearingPrice));
}

// Public read: the most recent clearing price, if any batch has settled.
export circuit lastClearingPrice(): Maybe<Uint<64>> {
  return lastPrint;
}
